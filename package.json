{
  "name": "genshindex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning apps/server/src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning apps/server/src/index.ts",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:check": "node scripts/db-check.mjs",
    "game-data:preview": "node scripts/preview-genshin-db.mjs",
    "kqm-index:preview": "node scripts/preview-kqm-index.mjs",
    "kqm-pages:preview": "node scripts/preview-kqm-pages.mjs",
    "enka-l10n:preview": "node scripts/preview-enka-localizations.mjs",
    "start:windows": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/sensible": "^6.0.3",
    "@tanstack/react-query": "^5.90.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.17",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.2",
    "leaflet": "^1.9.4",
    "motion": "^12.23.24",
    "recharts": "^2.15.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.2",
    "zod": "^4.1.12"
  }
